{
  "compilerOptions": {
    // General
    "jsx": "preserve",
    "jsxImportSource": "@solidjs/web",
    "target": "ESNext",

    // Modules
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "module": "ESNext",
    "moduleResolution": "bundler",
    "noEmit": true,

    // Type Checking & Safety
    "strict": true,
    "skipLibCheck": true,
    "types": ["vite/client", "@testing-library/jest-dom/vitest"],

    // Custom Paths
    "paths": {
      "@dasig": ["./builtin/index.ts"],
      "@dasig/api": ["./builtin/api/index.ts"],
      "@dasig/store": ["./builtin/scripts/functions/store.ts"],
      "@dasig/cache": ["./builtin/scripts/functions/cache.ts"],
      "@dasig/uuid": ["./builtin/scripts/functions/uuid.ts"],
      "@dasig/hash": ["./builtin/scripts/functions/hash.ts"],
      "@dasig/rsa": ["./builtin/scripts/functions/rsa.ts"],
      "configs/*": ["./configs/*"],
      "components/*": ["./src/components/*"],
      "images/*": ["./images/*"],
      "stores/*": ["./src/stores/*"],
      "cache/*": ["./src/cache/*"],
      "services": ["./src/services/index.ts"]
    }
  },
  "include": ["src", "builtin", "configs", "images"]
}
