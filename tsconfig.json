{
  "compilerOptions": {
    // General
    "jsx": "preserve",
    "jsxImportSource": "@solidjs/web",
    "target": "ESNext",

    // Modules
    "allowSyntheticDefaultImports": true,
    "allowImportingTsExtensions": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "module": "ESNext",
    "moduleResolution": "bundler",
    "noEmit": true,

    // Type Checking & Safety
    "strict": true,
    "skipLibCheck": true,
    "types": ["vite/client", "@testing-library/jest-dom/vitest"],
    "baseUrl": ".",
    "paths": {
      "@dasig": ["builtin/index.ts"],
      "@dasig/api": ["builtin/api/index.ts"],
      "configs/*": ["configs/*"],
      "components/*": ["src/components/*"],
      "images/*": ["images/*"],
      "stores/*": ["src/stores/*"],
      "@dasig/store": ["builtin/scripts/functions/store.ts"]
    }
  },
  "include": ["src", "builtin", "configs", "images"]
}
